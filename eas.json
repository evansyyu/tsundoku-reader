    },
    "production": {
      "distribution": "store",
      "ios": {
        "resourceClass": "m-medium"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6759067833",
        "appleTeamId": "Y7R3SD8HH4"
      }
    }
  }
}
