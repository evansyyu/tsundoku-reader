{
  "expo": {
    "name": "tsundoku",
    "slug": "yomu-reader",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "tsundokureader",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tsundoku.reader",
      "usesIcloudStorage": true,
      "icon": "./assets/tsundoku.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff",
        "dark": {
          "foregroundImage": "./assets/adaptive-icon-dark.png",
          "backgroundColor": "#1a1a1a"
        }
      },
      "edgeToEdgeEnabled": true,
      "package": "com.tsundoku.reader"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "135a15bf-cd5f-41f4-9704-522441fd0e00"
      }
    },
    "owner": "glitchedgadget"
  }
}